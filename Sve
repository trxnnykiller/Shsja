local Players = game:GetService("Players")
local player = Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local camera = workspace.CurrentCamera
local vim = game:GetService("VirtualInputManager")

local killerBlacklist = {
    Jane = true,
    Giant = true,
    Rake = true
}

-- 🔍 Safely detect the Killers folder (handles weird/hidden names)
local function getKillersFolder()
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Folder") and v.Name:match("^Killers") then
            return v
        end
    end
end

-- 🛠 RayGun handling
local function getRayGun()
    local character = player.Character or player.CharacterAdded:Wait()
    return backpack:FindFirstChild("RayGun") or character:FindFirstChild("RayGun")
end

local function hasRayGun()
    local rg = getRayGun()
    return rg ~= nil
end

local function equipRayGun()
    local character = player.Character or player.CharacterAdded:Wait()
    local rayGun = backpack:FindFirstChild("RayGun")
    if rayGun and character:FindFirstChild("Humanoid") then
        character.Humanoid:EquipTool(rayGun)
    end
end

local function teleportToRayGun()
    local character = player.Character or player.CharacterAdded:Wait()
    local rayGunModel = workspace:FindFirstChild("Weapons") and workspace.Weapons:FindFirstChild("RayGun") and workspace.Weapons.RayGun:FindFirstChild("RayGun")
    if character and character:FindFirstChild("HumanoidRootPart") and rayGunModel and rayGunModel.PrimaryPart then
        character.HumanoidRootPart.CFrame = rayGunModel.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
    end
end

-- 🧠 Smart RayGun retrieval (prevents infinite teleport)
local function ensureRayGun()
    local tries = 0
    while not hasRayGun() do
        teleportToRayGun()
        wait(1)
        tries += 1
        if tries > 15 then
            warn("⚠️ Could not acquire RayGun after 15 tries — retrying later.")
            return false
        end
    end
    equipRayGun()
    return true
end

-- 🧱 ESP setup for Killers
local function addESPToKillers()
    local killersFolder = getKillersFolder()
    if not killersFolder then return end

    for _, killer in ipairs(killersFolder:GetChildren()) do
        if not killerBlacklist[killer.Name] and killer:FindFirstChild("HumanoidRootPart") and not killer:FindFirstChild("ESP") then
            local esp = Instance.new("BillboardGui")
            esp.Name = "ESP"
            esp.Adornee = killer.HumanoidRootPart
            esp.Size = UDim2.new(0, 100, 0, 40)
            esp.AlwaysOnTop = true
            esp.Parent = killer

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = killer.Name
            label.TextColor3 = Color3.new(1, 0, 0)
            label.TextStrokeTransparency = 0
            label.Font = Enum.Font.SourceSansBold
            label.TextScaled = true
            label.Parent = esp
        end
    end
end

spawn(function()
    while true do
        addESPToKillers()
        wait(1)
    end
end)

-- 🔫 Auto reload when NoAmmo sound plays
local function listenNoAmmo()
    local rayGun = getRayGun()
    if rayGun and rayGun:FindFirstChild("Handle") and rayGun.Handle:FindFirstChild("NoAmmo") then
        local noAmmo = rayGun.Handle.NoAmmo
        if not noAmmo:IsA("Sound") then return end
        noAmmo.Played:Connect(function()
            vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)
    end
end

spawn(function()
    while true do
        listenNoAmmo()
        wait(2)
    end
end)

-- 🔥 Killer attack logic
local function killerAttackLoop()
    spawn(function()
        while true do
            ensureRayGun()
            local killersFolder = getKillersFolder()
            if killersFolder then
                for _, killer in ipairs(killersFolder:GetChildren()) do
                    if killerBlacklist[killer.Name] then continue end

                    local killerHRP = killer:FindFirstChild("HumanoidRootPart")
                    local humanoid = killer:FindFirstChildOfClass("Humanoid")
                    if killerHRP and humanoid and humanoid.Health > 0 then
                        local character = player.Character or player.CharacterAdded:Wait()
                        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

                        if humanoidRootPart then
                            humanoidRootPart.CFrame = CFrame.new(
                                killerHRP.Position - killerHRP.CFrame.LookVector * 3,
                                killerHRP.Position
                            )
                            equipRayGun()
                            humanoidRootPart.Anchored = true

                            camera.CameraType = Enum.CameraType.Scriptable
                            camera.CFrame = CFrame.new(character.Head.Position, killerHRP.Position)

                            local startTime = tick()
                            local skipped = false

                            while humanoid.Health > 0 and killer.Parent == killersFolder do
                                if tick() - startTime > 5 then
                                    skipped = true
                                    break
                                end

                                if not hasRayGun() then
                                    humanoidRootPart.Anchored = false
                                    camera.CameraType = Enum.CameraType.Custom
                                    ensureRayGun()
                                    break
                                end

                                equipRayGun()
                                camera.CFrame = CFrame.new(character.Head.Position, killerHRP.Position)

                                vim:SendMouseButtonEvent(
                                    workspace.CurrentCamera.ViewportSize.X / 2,
                                    workspace.CurrentCamera.ViewportSize.Y / 2,
                                    0,
                                    true,
                                    game,
                                    0
                                )
                                vim:SendMouseButtonEvent(
                                    workspace.CurrentCamera.ViewportSize.X / 2,
                                    workspace.CurrentCamera.ViewportSize.Y / 2,
                                    0,
                                    false,
                                    game,
                                    0
                                )

                                wait(0.1)
                            end

                            humanoidRootPart.Anchored = false
                            camera.CameraType = Enum.CameraType.Custom

                            if skipped then
                                teleportToRayGun()
                                ensureRayGun()
                            end
                        end
                    end
                end
            end
            wait(1)
        end
    end)
end

-- 🧩 Initialization
local function acquireRayGun()
    ensureRayGun()
    equipRayGun()
end

spawn(acquireRayGun)
killerAttackLoop()

player.CharacterAdded:Connect(function()
    spawn(acquireRayGun)
    killerAttackLoop()
end)

-- ⏰ Anti-AFK
spawn(function()
    while true do
        vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        wait(60)
    end
end)
