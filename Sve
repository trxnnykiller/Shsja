-- Get RayGun before attacking and after respawn
local function acquireRayGun()
    while not hasRayGun() do
        teleportToRayGun()
        wait(0.5)
    end
    equipRayGun()
end

-- Get RayGun before attacking and after respawn
spawn(acquireRayGun)
killerAttackLoop()
player.CharacterAdded:Connect(function()
    spawn(acquireRayGun)
    killerAttackLoop()
end)

